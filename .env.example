# Western Stampede — copy to .env for local dev (not required for Portainer casino preset)
NODE_ENV=development
PORT=3000

# casino (default) | default
WS_PRESET=casino

JWT_SECRET=dev-secret
RNG_PROVIDER=local
TOPUP_MODE=demo
# Casino preset default start balance (credits)
GUEST_START_BALANCE=100000
REAL_MONEY=false
COMPLIANCE_MODE=false

# Empty = MemoryStore (fine for demo). Durable:
# DATABASE_URL=postgres://ws:ws@127.0.0.1:15432/western_stampede
DATABASE_URL=

# Admin console: http://localhost:5173/admin.html or :18080/admin.html
ADMIN_TOKEN=dev-admin-token
CORS_ORIGIN=*

# Optional multi-node rate limit
# REDIS_URL=redis://127.0.0.1:6379
