# Build + run RGS API (no corepack — unreliable in many CI/Portainer builders)
FROM node:22-bookworm-slim AS build
WORKDIR /app

RUN npm install -g pnpm@10.33.0

COPY package.json pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/math-engine/package.json packages/math-engine/
COPY apps/rgs-api/package.json apps/rgs-api/

RUN pnpm install --no-frozen-lockfile

COPY packages packages
COPY apps/rgs-api apps/rgs-api

RUN pnpm --filter @ws/shared build \
 && pnpm --filter @ws/math-engine build \
 && pnpm --filter @ws/rgs-api build

# Runtime: ship built monorepo slice with node_modules (simple + reliable)
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /app/package.json /app/pnpm-workspace.yaml ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/apps/rgs-api ./apps/rgs-api

WORKDIR /app/apps/rgs-api
EXPOSE 3000
CMD ["node", "dist/main.js"]
