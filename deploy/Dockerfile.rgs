FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
COPY package.json pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/math-engine/package.json packages/math-engine/
COPY apps/rgs-api/package.json apps/rgs-api/
RUN pnpm install --frozen-lockfile=false
COPY packages packages
COPY apps/rgs-api apps/rgs-api
RUN pnpm --filter @ws/shared build \
 && pnpm --filter @ws/math-engine build \
 && pnpm --filter @ws/rgs-api build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
COPY package.json pnpm-workspace.yaml ./
COPY packages/shared/package.json packages/shared/
COPY packages/math-engine/package.json packages/math-engine/
COPY apps/rgs-api/package.json apps/rgs-api/
RUN pnpm install --prod --frozen-lockfile=false
COPY --from=build /app/packages/shared/dist packages/shared/dist
COPY --from=build /app/packages/math-engine/dist packages/math-engine/dist
COPY --from=build /app/apps/rgs-api/dist apps/rgs-api/dist
# package.json exports need types paths — ensure package.json present
COPY packages/shared/package.json packages/shared/
COPY packages/math-engine/package.json packages/math-engine/
WORKDIR /app/apps/rgs-api
EXPOSE 3000
CMD ["node", "dist/main.js"]
