{
  "name": "western-stampede",
  "version": "1.0.0",
  "private": true,
  "description": "Western Stampede — server-authoritative western ways slot (demo/social play)",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --parallel --filter @ws/rgs-api --filter @ws/client dev",
    "dev:api": "pnpm --filter @ws/rgs-api dev",
    "dev:client": "pnpm --filter @ws/client dev",
    "test": "pnpm -r run test",
    "math:sim": "pnpm --filter @ws/math-engine sim",
    "lint": "pnpm -r run lint --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
